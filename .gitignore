# CrewDEV TURN Server .gitignore

# Environment files
.env
.env.local
.env.production

# Log files
logs/
*.log

# SSL certificates
*.crt
*.key
*.pem
ssl/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Runtime files
*.pid
*.sock

# Configuration backups
*.conf.backup
*.conf.bak
