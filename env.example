# CrewDEV TURN Server Environment Variables
# Copy this file to .env and configure your settings

# Server Configuration
TURN_HOST=your-turn-server.com
TURN_PORT=3478
TURN_TLS_PORT=5349

# Authentication
TURN_SECRET=your-secure-secret-key-here
TURN_USERNAME=crewdev
TURN_REALM=crewdev.com

# External IP (REQUIRED)
TURN_EXTERNAL_IP=YOUR_PUBLIC_IP/PRIVATE_IP

# SSL/TLS Configuration
TURN_CERT_PATH=/etc/ssl/certs/coturn.crt
TURN_KEY_PATH=/etc/ssl/private/coturn.key

# Performance Settings
TURN_TOTAL_QUOTA=2000
TURN_USER_QUOTA=100
TURN_MIN_PORT=40000
TURN_MAX_PORT=50000

# Logging
TURN_LOG_LEVEL=info
TURN_LOG_FILE=/var/log/coturn/coturn.log

# Security
TURN_DENY_PRIVATE_IPS=true
TURN_ALLOWED_IPS=0.0.0.0-255.255.255.255
